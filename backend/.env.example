# Copia este archivo como `.env` y ajusta los valores.
# En cPanel, el `.env` real debe vivir fuera de public_html y apuntarse con CMS_ENV_FILE.
# CMS_ENV_FILE=/home/USUARIO/robotica-config/.env

APP_ENV=production
APP_BASE_PATH=/api

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=robotica
DB_USER=robotica
DB_PASS=change_me
DB_CHARSET=utf8mb4

SESSION_NAME=robotica_cms
SESSION_LIFETIME=7200
SESSION_SECURE=true

UPLOAD_MAX_BYTES=5242880
UPLOAD_BASE_PATH=/api/uploads

# Solo se usa al ejecutar `php bin/seed.php` la primera vez.
SEED_ADMIN_USER=admin
SEED_ADMIN_PASSWORD=change_me_now
SEED_ADMIN_NAME=Administrador
